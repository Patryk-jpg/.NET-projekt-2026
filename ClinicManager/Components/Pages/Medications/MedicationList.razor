@page "/medications"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using ClinicManager.Core.Constants
@using ClinicManager.Core.DTOs
@using ClinicManager.Core.Interfaces
@attribute [Authorize(Roles = $"{Roles.Lekarz},{Roles.Admin}")]

@inject IMedicationService MedicationService

<PageTitle>Leki</PageTitle>

<h1>Leki</h1>

<div class="row g-2 mb-3">
    <div class="col-sm-6 col-md-5">
        <input type="text"
               class="form-control"
               placeholder="Nazwa leku"
               @bind="query"
               @bind:event="oninput"
               @onkeyup="OnKeyUp" />
    </div>
    <div class="col-auto">
        <button type="button" class="btn btn-primary" @onclick="LoadAsync">Szukaj</button>
    </div>
    <div class="col-auto ms-auto">
        <a class="btn btn-success" href="/medications/new">+ Dodaj lek</a>
    </div>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (loading)
{
    <p class="text-muted">Ladowanie...</p>
}
else if (medications.Count == 0)
{
    <div class="alert alert-info">Brak lekow pasujacych do filtra.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
        <tr>
            <th>Nazwa</th>
            <th class="text-end">Cena jednostkowa</th>
            <th class="text-end">Akcje</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var medication in medications)
        {
            <tr>
                <td>@medication.Name</td>
                <td class="text-end">@FormatCost(medication.UnitPrice)</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" href="@($"/medications/{medication.Id}/edit")">Edytuj</a>
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            @onclick="() => DeleteAsync(medication.Id)">
                        Usun
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private string? query;
    private List<MedicationDto> medications = [];
    private bool loading;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;
        try
        {
            medications = (await MedicationService.SearchAsync(query)).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Nie udalo sie pobrac lekow: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnKeyUp(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(int id)
    {
        errorMessage = null;
        try
        {
            await MedicationService.DeleteAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private static string FormatCost(decimal value) => $"{value:0.00} zl";
}
