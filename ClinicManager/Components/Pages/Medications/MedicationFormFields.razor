@using ClinicManager.Core.DTOs

<div class="row g-3">
    <div class="col-md-8">
        <label class="form-label" for="medication-name">Nazwa leku</label>
        <InputText id="medication-name" class="form-control" @bind-Value="Form.Name" />
        <ValidationMessage For="@(() => Form.Name)" />
    </div>
    <div class="col-md-4">
        <label class="form-label" for="medication-price">Cena jednostkowa</label>
        <InputNumber id="medication-price" class="form-control" @bind-Value="Form.UnitPrice" />
        <ValidationMessage For="@(() => Form.UnitPrice)" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MedicationFormDto Form { get; set; } = default!;
}
