@page "/patients/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using ClinicManager.Core.Constants
@using ClinicManager.Core.DTOs
@using ClinicManager.Core.Enums
@using ClinicManager.Core.Interfaces
@attribute [Authorize(Roles = $"{Roles.Rejestratorka},{Roles.Admin},{Roles.Lekarz}")]

@inject IPatientService PatientService
@inject IVisitService VisitService
@inject NavigationManager Navigation

<PageTitle>Pacjent</PageTitle>

@if (loading)
{
    <p class="text-muted">Ladowanie...</p>
}
else if (patient is null)
{
    <h1>Pacjent</h1>
    <div class="alert alert-warning">Nie znaleziono pacjenta.</div>
    <a href="/patients" class="btn btn-link">Wroc do listy</a>
}
else
{
    <h1>@patient.FirstName @patient.LastName</h1>

    @if (patient.AnonymizedAt.HasValue)
    {
        <div class="alert alert-danger">Dane pacjenta zostaly zanonimizowane (RODO) @patient.AnonymizedAt.Value.ToString("yyyy-MM-dd HH:mm") UTC.</div>
    }
    else if (patient.IsDeleted)
    {
        <div class="alert alert-secondary">Pacjent jest oznaczony jako usuniety od @(patient.DeletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—") UTC.</div>
    }

    <dl class="row">
        <dt class="col-sm-3">PESEL</dt>
        <dd class="col-sm-9"><code>@patient.Pesel</code></dd>

        <dt class="col-sm-3">Numer ubezpieczenia</dt>
        <dd class="col-sm-9">@patient.InsuranceNumber</dd>

        <dt class="col-sm-3">Data urodzenia</dt>
        <dd class="col-sm-9">@patient.DateOfBirth.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Telefon</dt>
        <dd class="col-sm-9">@patient.Phone</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@patient.Email</dd>

        <dt class="col-sm-3">Dodany</dt>
        <dd class="col-sm-9">@patient.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>

    <div class="d-flex gap-2 mb-4">
        <a class="btn btn-info" href="@($"/patients/{Id}/record")">Kartoteka i dokumenty</a>
        <AuthorizeView Roles="@($"{Roles.Rejestratorka},{Roles.Admin}")">
            @if (!patient.IsDeleted)
            {
                <a class="btn btn-secondary" href="@($"/patients/{Id}/edit")">Edytuj</a>
                <button class="btn btn-outline-danger" @onclick="SoftDeleteAsync">Usun (soft delete)</button>
            }
            @if (patient.IsDeleted && !patient.AnonymizedAt.HasValue)
            {
                <button class="btn btn-danger" @onclick="AnonymizeAsync">Anonimizuj (RODO)</button>
            }
        </AuthorizeView>
        <a class="btn btn-link ms-auto" href="/patients">Wroc do listy</a>
    </div>

    <h2 class="h4 d-flex align-items-center">
        <span>Wizyty</span>
        <AuthorizeView Roles="@($"{Roles.Rejestratorka},{Roles.Admin}")">
            <a class="btn btn-sm btn-success ms-3" href="@($"/visits/new?patientId={Id}")">+ Dodaj wizyte</a>
        </AuthorizeView>
    </h2>

    @if (visits.Count == 0)
    {
        <div class="alert alert-light border">Pacjent nie ma jeszcze wizyt.</div>
    }
    else
    {
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>Termin</th>
                    <th>Lekarz</th>
                    <th>Status</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var visit in visits)
                {
                    <tr>
                        <td>@visit.ScheduledAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@visit.Doctor.FirstName @visit.Doctor.LastName <span class="text-muted small">(@visit.Doctor.Specialization)</span></td>
                        <td><VisitStatusBadge Status="visit.Status" /></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="@($"/visits/{visit.Id}")">Szczegoly</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private PatientDto? patient;
    private List<VisitDto> visits = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        patient = await PatientService.GetByIdAsync(Id);
        if (patient is not null)
        {
            visits = (await VisitService.GetForPatientAsync(Id)).ToList();
        }
        loading = false;
    }

    private async Task SoftDeleteAsync()
    {
        if (patient is null) return;
        await PatientService.SoftDeleteAsync(patient.Id);
        Navigation.NavigateTo("/patients");
    }

    private async Task AnonymizeAsync()
    {
        if (patient is null) return;
        await PatientService.AnonymizeAsync(patient.Id);
        patient = await PatientService.GetByIdAsync(Id, includeDeleted: true);
    }

}
