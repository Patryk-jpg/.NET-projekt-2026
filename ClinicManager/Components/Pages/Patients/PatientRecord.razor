@page "/patients/{Id:int}/record"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using ClinicManager.Core.Constants
@using ClinicManager.Core.DTOs
@using ClinicManager.Core.Interfaces
@attribute [Authorize(Roles = $"{Roles.Rejestratorka},{Roles.Admin},{Roles.Lekarz}")]

@inject IPatientService PatientService
@inject IMedicalRecordService MedicalRecordService
@inject NavigationManager Navigation

<PageTitle>Kartoteka pacjenta</PageTitle>

@if (loading)
{
    <p class="text-muted">Ladowanie...</p>
}
else if (patient is null)
{
    <h1>Kartoteka pacjenta</h1>
    <div class="alert alert-warning">Nie znaleziono pacjenta.</div>
    <a class="btn btn-link" href="/patients">Wroc do listy</a>
}
else
{
    <h1>Kartoteka: @patient.FirstName @patient.LastName</h1>

    @if (patient.IsDeleted)
    {
        <div class="alert alert-secondary">Pacjent jest oznaczony jako usuniety.</div>
    }

    <dl class="row">
        <dt class="col-sm-3">PESEL</dt>
        <dd class="col-sm-9"><code>@patient.Pesel</code></dd>

        <dt class="col-sm-3">Numer ubezpieczenia</dt>
        <dd class="col-sm-9">@patient.InsuranceNumber</dd>

        <dt class="col-sm-3">Data urodzenia</dt>
        <dd class="col-sm-9">@patient.DateOfBirth.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Telefon</dt>
        <dd class="col-sm-9">@patient.Phone</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@patient.Email</dd>

        <dt class="col-sm-3">Kartoteka utworzona</dt>
        <dd class="col-sm-9">@(record?.CreatedAt.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
    </dl>

    <h2 class="h4 mt-4">Skan dokumentu</h2>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (successMessage is not null)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (!string.IsNullOrEmpty(record?.DocumentScanUrl))
    {
        <p>
            <a class="btn btn-outline-primary" href="@record.DocumentScanUrl" target="_blank" rel="noopener">
                Otworz / pobierz biezacy dokument
            </a>
        </p>
    }
    else
    {
        <p class="text-muted">Brak dolaczonego skanu dokumentu.</p>
    }

    <AuthorizeView Roles="@($"{Roles.Rejestratorka},{Roles.Admin}")">
        <div class="card mb-3">
            <div class="card-body">
                <h3 class="h6">Wgraj nowy skan</h3>
                <p class="text-muted small mb-2">
                    Dozwolone rozszerzenia: @string.Join(", ", MedicalRecordUpload.AllowedExtensions).
                    Maksymalny rozmiar: @(MedicalRecordUpload.MaxFileSizeBytes / (1024 * 1024)) MB.
                </p>

                <InputFile OnChange="OnFileSelected"
                           accept="@MedicalRecordUpload.HtmlAcceptList"
                           class="form-control"
                           disabled="@uploading" />

                @if (uploading)
                {
                    <div class="text-muted mt-2">Wgrywanie pliku...</div>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(record?.DocumentScanUrl))
        {
            <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync" disabled="@uploading">
                Usun aktualny dokument
            </button>
        }
    </AuthorizeView>

    <div class="mt-3">
        <a class="btn btn-link" href="@($"/patients/{Id}")">Wroc do szczegolow pacjenta</a>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private PatientDto? patient;
    private MedicalRecordDto? record;
    private bool loading = true;
    private bool uploading;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            patient = await PatientService.GetByIdAsync(Id);
            if (patient is not null)
            {
                record = await MedicalRecordService.GetOrCreateForPatientAsync(Id);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        errorMessage = null;
        successMessage = null;
        uploading = true;
        try
        {
            var file = args.File;
            if (file.Size > MedicalRecordUpload.MaxFileSizeBytes)
            {
                var sizeMb = file.Size / (double)(1024 * 1024);
                errorMessage = $"Plik jest za duzy ({sizeMb:F1} MB). Limit: " +
                               $"{MedicalRecordUpload.MaxFileSizeBytes / (1024 * 1024)} MB.";
                return;
            }

            await using var stream = file.OpenReadStream(MedicalRecordUpload.MaxFileSizeBytes);
            record = await MedicalRecordService.UploadDocumentAsync(
                Id, stream, file.Name, file.Size);
            successMessage = $"Wgrano plik {file.Name}.";
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Nie udalo sie wgrac pliku: {ex.Message}";
        }
        finally
        {
            uploading = false;
        }
    }

    private async Task DeleteAsync()
    {
        errorMessage = null;
        successMessage = null;
        try
        {
            var deleted = await MedicalRecordService.DeleteDocumentAsync(Id);
            if (deleted)
            {
                record = await MedicalRecordService.GetOrCreateForPatientAsync(Id);
                successMessage = "Dokument zostal usuniety.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Nie udalo sie usunac dokumentu: {ex.Message}";
        }
    }
}
