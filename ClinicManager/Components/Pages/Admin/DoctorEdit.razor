@page "/admin/doctors/{Id:int}/edit"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using ClinicManager.Core.Constants
@using ClinicManager.Core.DTOs
@using ClinicManager.Core.Interfaces
@attribute [Authorize(Roles = Roles.Admin)]

@inject IDoctorAdminService DoctorAdminService
@inject NavigationManager Navigation

<PageTitle>Edycja lekarza</PageTitle>

<h1>Edycja lekarza</h1>

@if (loading)
{
    <p class="text-muted">Ladowanie...</p>
}
else if (form is null)
{
    <div class="alert alert-warning">Lekarz nie istnieje.</div>
    <a class="btn btn-link" href="/admin/doctors">Wroc do listy</a>
}
else
{
    @if (errorMessage is not null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <EditForm Model="form" OnValidSubmit="SubmitAsync" FormName="doctor-edit">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <DoctorFormFields Form="form" />

        <div class="mt-3">
            <button type="submit" class="btn btn-primary" disabled="@saving">
                @(saving ? "Zapisywanie..." : "Zapisz zmiany")
            </button>
            <a class="btn btn-link" href="/admin/doctors">Anuluj</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private DoctorEditFormDto? form;
    private bool loading = true;
    private bool saving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var doctor = await DoctorAdminService.GetByIdAsync(Id);
        if (doctor is not null)
        {
            form = new DoctorEditFormDto
            {
                FirstName = doctor.FirstName,
                LastName = doctor.LastName,
                Specialization = doctor.Specialization
            };
        }

        loading = false;
    }

    private async Task SubmitAsync()
    {
        if (form is null)
        {
            return;
        }

        saving = true;
        errorMessage = null;
        try
        {
            var updated = await DoctorAdminService.UpdateAsync(Id, form);
            if (updated is null)
            {
                errorMessage = "Nie znaleziono lekarza. Mogl zostac usuniety w innej sesji.";
                return;
            }

            Navigation.NavigateTo("/admin/doctors");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
